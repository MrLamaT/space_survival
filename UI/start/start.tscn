[sub_resource type="GDScript" id="GDScript_dossier"]
script/source = "extends Node2D

const PLUSH_SOURCE := preload(\"res://game/prop/plush.tscn\")
const CLASSIC_SKIN := preload(\"res://assets/skin_npc/fox_black.png\")
const TRAINING := \"res://game/rooms/maps/simulation/training.tscn\"

const ENGLISH := {
	\"ОГРАНИЧЕННЫЙ ДОСТУП\": \"RESTRICTED ACCESS\",
	\"Личное дело\": \"Personnel File\",
	\"Имя\": \"Name\",
	\"Пол\": \"Sex\",
	\"Мужской\": \"Male\",
	\"Вид\": \"Species\",
	\"Лис\": \"Fox\",
	\"Гражданство\": \"Citizenship\",
	\"Цитадель\": \"Citadel\",
	\"Статус\": \"Status\",
	\"Чистильщик\": \"Cleaner\",
	\"Возраст\": \"Age\",
	\"25 лет\": \"25\",
	\"Проживание\": \"Residence\",
	\"Транзитный блок 06, сектор «Кромка»\": \"Transit Block 06, Rim Sector\",

	\"Задача\": \"Objective\",
	\"Проникнуть через портал, нейтрализовать все цели, утратившие контроль, добраться до точки активации и инициировать подрыв объекта.\": \"Enter through the portal, neutralize all targets no longer under Citadel control, reach the activation point, and initiate the demolition of the facility.\",
	\"Разрешены любые средства, найденные на месте. Сбор вооружения, ресурсов и модификация экипировки поощряются.\": \"Use any equipment found on site. Collecting weapons and resources and modifying gear are encouraged.\",

	\"Права Чистильщика\": \"Cleaner Authorizations\",
	\"Маршрут и эвакуация\": \"Transit and evacuation\",
	\"Пользоваться назначенным порталом, выбирать маршрут на объекте и запрашивать эвакуацию при угрозе жизни.\": \"Use the assigned portal, choose a route through the facility, and request evacuation if your life is in danger.\",
	\"Доступ к объекту\": \"Facility access\",
	\"Входить в служебные зоны по заданию, считывать местные журналы и работать с терминалами, если это нужно для выполнения задачи.\": \"Enter service areas, read local logs, and operate terminals as required for the assignment.\",
	\"Снаряжение и ресурсы\": \"Equipment and resources\",
	\"Подбирать вооружение и материалы, заменять повреждённые узлы и модифицировать экипировку в поле.\": \"Recover weapons and materials, replace damaged components, and modify equipment in the field.\",
	\"Управление объектом\": \"Facility controls\",
	\"Включать поля подавления и аварийные системы. Инициировать подрыв только назначенного объекта.\": \"Enable suppression fields and emergency systems. Initiate demolition only at the assigned facility.\",
	\"Поддержка Цитадели\": \"Citadel support\",
	\"Запрашивать данные об объекте, связь с куратором и медицинскую помощь до и после выхода.\": \"Request site data, contact your handler, and seek medical care before and after deployment.\",
	\"Границы полномочий\": \"Limits of authority\",
	\"Допуск действует только на время задания.\": \"Clearance is valid only for the duration of the assignment.\",

	\"Характеристика\": \"Personnel Profile\",
	\"ЛИЧНЫЙ СОСТАВ / ПРИЛОЖЕНИЕ К ДЕЛУ\": \"PERSONNEL / FILE SUPPLEMENT\",
	\"Личные характеристики\": \"Personal Profile\",
	\"Прежняя работа\": \"Former occupation\",
	\"Контрабандист и сборщик оружия. После задержания принял службу Чистильщиком взамен тюремного срока.\": \"Smuggler and weapons assembler. After his arrest, he accepted service as a Cleaner in lieu of prison.\",
	\"CMD-фактор\": \"CMD Factor\",
	\"Даёт ускоренную регенерацию, повышенную силу и быструю адаптацию к физическим нагрузкам.\": \"Grants accelerated regeneration, increased strength, and rapid adaptation to physical strain.\",
	\"Заметки о Чистильщике\": \"Notes on the Cleaner\",
	\"Быстрый.\": \"Fast.\",
	\"Разбирается в сборке оружия.\": \"Skilled at assembling weapons.\",
	\"Слегка высокомерный.\": \"Slightly arrogant.\",
	\"Торгуется даже при выдаче снаряжения.\": \"Haggles even when equipment is issued.\",
	\"Неохотно говорит о бывших заказчиках.\": \"Reluctant to discuss former clients.\",
	\"Чинит инструменты, которые другие списали.\": \"Repairs tools others have written off.\",

	\"Управление\": \"Controls\",
	\"Движение\": \"Movement\",
	\"W, A, S, D — передвижение\\nShift — рывок\\nSpace — прыжок\\nCtrl — скольжение\": \"W, A, S, D — move\\nShift — dash\\nSpace — jump\\nCtrl — slide\",
	\"Взаимодействие\": \"Interaction\",
	\"E — взаимодействие с объектами\\nF — фонарик\": \"E — interact with objects\\nF — toggle flashlight\",
	\"Оружие\": \"Weapons\",
	\"1–5 — слоты оружия\\nЛКМ — стрельба\\nПКМ — альтернативная стрельба\": \"1–5 — weapon slots\\nLMB — fire\\nRMB — alternate fire\",
}

const typing_speed: float = 0.025
const preview_model: PackedScene = preload(\"res://game/Player/visual_model_player.tscn\")
const rotation_speed := 0.32

@onready var panel: Panel = $Panel
@onready var scroll: ScrollContainer = $Panel/Layout/Scroll
@onready var content: VBoxContainer = $Panel/Layout/Scroll/Center/Content
@onready var dossier: VBoxContainer = $Panel/Layout/Scroll/Center/Content/Dossier
@onready var profile: VBoxContainer = $Panel/Layout/Scroll/Center/Content/Profile
@onready var controls: VBoxContainer = $Panel/Layout/Scroll/Center/Content/Controls
@onready var back_button: Button = $Panel/Layout/Footer/Buttons/Back
@onready var next_button: Button = $Panel/Layout/Footer/Buttons/Next
@onready var pivot: Node3D = $Panel/Layout/Scroll/Center/Content/Dossier/PreviewRow/Preview/Viewport/Pivot

var _original_texts: Dictionary[Label, String] = {}
var _skip_typing := false
var _page := 0
var _russian := true
var _loading := false

func _ready() -> void:
	for node in content.find_children(\"*\", \"Label\", true, false):
		var label := node as Label
		_original_texts[label] = label.text
	Input.set_mouse_mode(Input.MOUSE_MODE_VISIBLE)
	_show_language_picker()

func _input(event: InputEvent) -> void:
	if event.is_action_pressed(\"ui_cancel\"):
		_skip_typing = true

func _show_language_picker() -> void:
	var prompt := \"Select language\"
	var label: Label = $language/Label
	label.text = \"\"
	_skip_typing = false
	for index in range(prompt.length()):
		if _skip_typing:
			label.text = prompt
			break
		label.text += prompt[index]
		await get_tree().create_timer(typing_speed).timeout
	await get_tree().create_timer(0.5).timeout
	$language/AnimationPlayer.play(\"language\")

func _on_En_pressed() -> void:
	_open_dossier(\"en\")

func _on_Ru_pressed() -> void:
	_open_dossier(\"ru\")

func _on_En_mouse_entered() -> void:
	$language/usa.scale = Vector2(1.25, 1.25)

func _on_En_mouse_exited() -> void:
	$language/usa.scale = Vector2.ONE

func _on_Ru_mouse_entered() -> void:
	$language/ru.scale = Vector2(1.25, 1.25)

func _on_Ru_mouse_exited() -> void:
	$language/ru.scale = Vector2.ONE

func _open_dossier(locale: String) -> void:
	_russian = locale == \"ru\"
	TranslationServer.set_locale(locale)
	Global.game_settings[\"gui_settings\"][\"Language\"] = TranslationServer.get_locale()
	Global.save(0)
	for label in _original_texts:
		if not is_instance_valid(label):
			continue
		var original: String = _original_texts[label]
		label.text = original if _russian else ENGLISH.get(original.strip_edges(), original)
	_build_preview()
	$language.hide()
	panel.show()
	_show_page(0)

func _show_page(index: int) -> void:
	_page = index
	dossier.visible = _page == 0
	profile.visible = _page == 1
	controls.visible = _page == 2
	back_button.disabled = _page == 0
	back_button.text = \"Назад\" if _russian else \"Back\"
	if _page == 2:
		next_button.text = \"Продолжить\" if _russian else \"Continue\"
	else:
		next_button.text = \"Далее\" if _russian else \"Next\"
	scroll.set_deferred(\"scroll_vertical\", 0)

func _on_back_pressed() -> void:
	if not _loading and _page > 0:
		_show_page(_page - 1)

func _on_next_pressed() -> void:
	if _loading:
		return
	if _page < 2:
		_show_page(_page + 1)
		return
	_loading = true
	back_button.disabled = true
	next_button.disabled = true
	await SceneManager.load_scene_with_loading(TRAINING)
	if is_inside_tree():
		_loading = false
		back_button.disabled = false
		next_button.disabled = false

func _build_preview() -> void:
	if pivot.get_child_count() > 0:
		return
	if preview_model != null:
		pivot.add_child(preview_model.instantiate())
		return
	var prop := PLUSH_SOURCE.instantiate()
	var model := prop.get_node(\"Node3D\") as Node3D
	prop.remove_child(model)
	prop.free()
	model.position.x = 0.0
	for part in model.find_children(\"*\", \"MeshInstance3D\", true, false):
		part.set(\"atlas_texture\", CLASSIC_SKIN)
	var head := model.get_node(\"head\") as Node3D
	var left_arm := model.get_node(\"hand1\") as Node3D
	var right_arm := model.get_node(\"hand2\") as Node3D
	head.rotate_y(deg_to_rad(17.0))
	head.rotate_z(deg_to_rad(-8.0))
	left_arm.rotate_z(deg_to_rad(18.0))
	right_arm.rotate_z(deg_to_rad(-12.0))
	pivot.add_child(model)

func _process(delta: float) -> void:
	if panel.visible and _page == 0:
		pivot.rotate_y(rotation_speed * delta)
"

