[node name="hologramText" parent="5" unique_id=1039195517 instance=ExtResource("4_wot7y")]
textLabel_ru = "Ваш корабль — это единственная линия жизни. Он летит по 
маршруту автоматически. Ваша задача — покидать его через 
порталы, чтобы собирать ресурсы и активировать новые 
точки перехода. Запомните главное правило:
1. Портал открыт ограниченное время. 
2. Вы всегда должны вернуться."
textLabel_en = "Your ship is your only lifeline. It flies along its 
route automatically. Your task is to 
leave it through 
portals to gather resources and activate new transition points.
Remember the main rule:
1. The portal is open for a limited time.
2. You must always come back."

