[node name="hologramText2" parent="8" unique_id=1310560578 instance=ExtResource("4_wot7y")]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 2.5, 0, -4.727)
textLabel_ru = "Как только вы открываете портал для высадки, у 
вас есть лимит времени. В нашем случае — 120 
секунд. В вашем — он будет зависеть от реакторов 
вашего корабля.
Когда таймер достигнет нуля, портал закроется. "
textLabel_en = "As soon as you open a landing portal, you have a 
time limit. In our case — 120 seconds. 
In your case — it will depend on your ship's reactors.
When the timer reaches zero, the portal will close."

