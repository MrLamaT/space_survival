; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="space_survival"
run/main_scene="uid://2b46d713lssn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="uid://c644es5qjluwt"

[autoload]

Global="*res://global.gd"
SceneManager="*res://chapter2/load/SceneManager.gd"

[display]

window/size/mode=3
window/stretch/mode="viewport"
window/stretch/aspect="ignore"
mouse_cursor/custom_image="uid://dau464ipul7m4"

[editor_plugins]

enabled=PackedStringArray()

[file_customization]

folder_colors={
"res://UI/": "purple",
"res://assets/": "green",
"res://chapter2/": "orange"
}

[global_group]

